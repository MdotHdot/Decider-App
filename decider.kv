#:kivy 2.1.0

<MovieListItem>:
    size_hint_y: None
    height: "60dp"
    padding: 8
    spacing: 8
    canvas.before:
        Color:
            rgba: 0.15, 0.15, 0.2, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.title
        color: 1, 1, 1, 1
        halign: "left"
        text_size: self.width, None
    Label:
        text: f"{root.genre} | {root.duration}m"
        color: 0.8, 0.8, 0.9, 1
        size_hint_x: None
        width: "120dp"
    Label:
        text: str(root.rating)
        color: 1, 0.85, 0.4, 1
        size_hint_x: None
        width: "50dp"
    Label:
        text: root.mood
        color: 0.7, 0.7, 0.8, 1
        size_hint_x: None
        width: "180dp"

<WelcomeScreen>:
    name: "welcome"
    BoxLayout:
        orientation: "vertical"
        padding: 24
        spacing: 16
        canvas.before:
            Color:
                rgba: 0.08, 0.08, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: "🎬 Movie Decider"
            font_size: "32sp"
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "60dp"
        Label:
            text: "Can't decide what to watch?\nPick by mood, genre, or time available."
            halign: "center"
            valign: "middle"
            color: 0.75, 0.75, 0.85, 1
            text_size: self.width, None
            size_hint_y: None
            height: "80dp"
        Widget:
        Button:
            text: "Let's go"
            size_hint_y: None
            height: "50dp"
            background_color: 0.3, 0.5, 0.9, 1
            on_release: app.root.current = "main"

<MainScreen>:
    name: "main"
    BoxLayout:
        orientation: "vertical"
        padding: 8
        spacing: 8
        canvas.before:
            Color:
                rgba: 0.08, 0.08, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: 6
            Button:
                text: "Mood"
                background_color: 0.35, 0.55, 0.95, 1
                on_release: root.open_filter("mood")
            Button:
                text: "Genre"
                background_color: 0.35, 0.75, 0.55, 1
                on_release: root.open_filter("genre")
            Button:
                text: "Duration"
                background_color: 0.95, 0.65, 0.25, 1
                on_release: root.open_filter("duration")
            Button:
                text: "Advanced"
                background_color: 0.6, 0.4, 0.85, 1
                on_release: app.root.current = "advanced"
            Button:
                text: "Home"
                size_hint_x: None
                width: "70dp"
                on_release: app.root.current = "welcome"

        Label:
            text: root.selected
            color: 0.85, 0.85, 0.95, 1
            size_hint_y: None
            height: "36dp"

        Label:
            text: "All movies (sorted by rating)"
            color: 0.6, 0.6, 0.7, 1
            font_size: "14sp"
            size_hint_y: None
            height: "24dp"

        ScrollView:
            GridLayout:
                id: movies_grid
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: "60dp"
                row_force_default: True
                spacing: 6
                padding: 4

<InputScreen>:
    name: "input"
    BoxLayout:
        orientation: "vertical"
        padding: 16
        spacing: 12
        canvas.before:
            Color:
                rgba: 0.08, 0.08, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: root.prompt_text
            font_size: "22sp"
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "40dp"

        # --- Mood panel (working) ---
        BoxLayout:
            id: mood_panel
            orientation: "vertical"
            spacing: 8
            size_hint_y: None
            height: "80dp"
            Spinner:
                id: mood_spinner
                text: "contemplative"
                values: []
                size_hint_y: None
                height: "44dp"

        # --- Genre panel (Exercise 1) ---
        BoxLayout:
            id: genre_panel
            orientation: "vertical"
            spacing: 8
            opacity: 0
            disabled: True
            size_hint_y: None
            height: "80dp"
            Spinner:
                id: genre_spinner
                text: "Drama"
                values: []
                size_hint_y: None
                height: "44dp"

        # --- Duration panel (Exercise 2) ---
        BoxLayout:
            id: duration_panel
            orientation: "vertical"
            spacing: 8
            opacity: 0
            disabled: True
            size_hint_y: None
            height: "80dp"
            TextInput:
                id: duration_input
                text: "120"
                input_filter: "int"
                multiline: False
                hint_text: "Minutes available"
                size_hint_y: None
                height: "44dp"
                padding: [12, 10]

        Widget:

        BoxLayout:
            size_hint_y: None
            height: "50dp"
            spacing: 8
            Button:
                text: "Back"
                on_release: app.root.current = "main"
            Button:
                text: "Recommend"
                background_color: 0.3, 0.5, 0.9, 1
                on_release: root.submit()

<ResultScreen>:
    name: "result"
    BoxLayout:
        orientation: "vertical"
        padding: 12
        spacing: 8
        canvas.before:
            Color:
                rgba: 0.08, 0.08, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "Your recommendation"
            font_size: "24sp"
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "40dp"

        Label:
            text: root.result_text
            halign: "center"
            valign: "middle"
            color: 0.9, 0.9, 1, 1
            text_size: self.width, None
            size_hint_y: None
            height: "90dp"

        Label:
            text: "All matches"
            color: 0.6, 0.6, 0.7, 1
            font_size: "14sp"
            size_hint_y: None
            height: "24dp"

        ScrollView:
            GridLayout:
                id: results_grid
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: "60dp"
                row_force_default: True
                spacing: 6

        Button:
            text: "Try another filter"
            size_hint_y: None
            height: "50dp"
            background_color: 0.3, 0.5, 0.9, 1
            on_release: app.root.current = "main"

        Button:
            text: "Suprise Me!"
            size_hint_y: None
            height: "50dp"
            background_color: 0.6, 0.4, 0.85, 1
            on_release: root.surprise_me()

<AdvancedSearchScreen>:
    name: "advanced"
    BoxLayout:
        orientation: "vertical"
        padding: 16
        spacing: 12
        canvas.before:
            Color:
                rgba: 0.08, 0.08, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "Advanced Search"
            font_size: "24sp"
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "40dp"

        Label:
            text: "Combine mood, genre, and duration to narrow your pick."
            color: 0.7, 0.7, 0.8, 1
            font_size: "14sp"
            halign: "center"
            text_size: self.width, None
            size_hint_y: None
            height: "40dp"

        Label:
            text: "Mood"
            color: 0.85, 0.85, 0.95, 1
            size_hint_y: None
            height: "24dp"
        Spinner:
            id: adv_mood_spinner
            text: "Any"
            values: ["Any"]
            size_hint_y: None
            height: "44dp"

        Label:
            text: "Genre"
            color: 0.85, 0.85, 0.95, 1
            size_hint_y: None
            height: "24dp"
        Spinner:
            id: adv_genre_spinner
            text: "Any"
            values: ["Any"]
            size_hint_y: None
            height: "44dp"

        Label:
            text: "Max duration (minutes)"
            color: 0.85, 0.85, 0.95, 1
            size_hint_y: None
            height: "24dp"
        TextInput:
            id: adv_duration_input
            text: "150"
            input_filter: "int"
            multiline: False
            hint_text: "e.g. 120"
            size_hint_y: None
            height: "44dp"
            padding: [12, 10]

        Label:
            text: root.status_text
            color: 0.6, 0.8, 1, 1
            font_size: "13sp"
            size_hint_y: None
            height: "30dp"

        Label:
            text: "Minimum rating:"
            color: 0.6, 0.6, 0.7, 1
            font_size: "14sp"
            size_hint_y: None
            height: "24dp"

        TextInput:
            id: adv_rating_input
            text: "Any"
            multiline: False
            hint_text: "e.g. 8.5 or Any"
            size_hint_y: None
            height: "44dp"
            padding: [12, 10]

        Widget:

        BoxLayout:
            size_hint_y: None
            height: "50dp"
            spacing: 8
            Button:
                text: "Back"
                on_release: app.root.current = "main"
            Button:
                text: "Search"
                background_color: 0.6, 0.4, 0.85, 1
                on_release: root.submit()

<DeciderRoot>:
    WelcomeScreen:
    MainScreen:
    InputScreen:
    AdvancedSearchScreen:
    ResultScreen:
